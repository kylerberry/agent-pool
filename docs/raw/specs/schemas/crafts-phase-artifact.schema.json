{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crafts-phase-artifact.schema.json",
  "title": "CRAFTS Phase Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "node_id", "attempt_id", "phase", "status", "model",
    "started_at", "completed_at", "summary", "acceptance_criteria_status",
    "changed_files", "commands_run", "cost", "risks", "open_questions",
    "recommended_next_step", "failure_context", "transcript_path", "phase_data"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["C", "R", "A", "F", "T", "S"] },
    "status": { "enum": ["passed", "needs_fix", "failed", "blocked"] },
    "model": { "type": "string", "pattern": "^[^/]+/.+$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "acceptance_criteria_status": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "status": { "enum": ["met", "unmet", "unknown", "not_tested"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "changed_files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "output_artifact"],
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "output_artifact": { "type": ["string", "null"] }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "amount", "currency"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "recommended_next_step": { "type": "string" },
    "failure_context": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempted", "failure_reason", "discoveries", "dead_ends"],
          "properties": {
            "attempted": { "type": "array", "items": { "type": "string" } },
            "failure_reason": { "type": "string" },
            "discoveries": { "type": "array", "items": { "type": "string" } },
            "dead_ends": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "transcript_path": {
      "type": ["string", "null"],
      "description": "Deprecated transient workspace-relative extraction locator. Never a durable audit reference; replaced by ADR-026 transcript_object_id metadata after verified extraction.",
      "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*$"
    },
    "phase_data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "not": { "const": "passed" } } } },
      "then": { "properties": { "failure_context": { "type": "object" } } }
    },
    {
      "if": { "properties": { "phase": { "enum": ["C", "A", "T"] } } },
      "then": { "properties": { "changed_files": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "phase": { "const": "C" } } },
      "then": {
        "properties": {
          "phase_data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["complexity", "selected_flow", "scope", "non_goals", "test_strategy", "planned_files", "trust_boundaries", "security_triggers", "render_plan"],
            "properties": {
              "complexity": { "enum": ["lite", "full"] },
              "selected_flow": { "enum": ["R-S", "C-R-A-F-T-S"] },
              "scope": { "type": "string" },
              "non_goals": { "type": "array", "items": { "type": "string" } },
              "test_strategy": { "type": "array", "items": { "type": "string" } },
              "planned_files": { "type": "array", "items": { "type": "string" } },
              "trust_boundaries": { "type": "array", "items": { "type": "string" } },
              "security_triggers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": ["trust-boundary-change", "untrusted-input", "authentication-authorization", "secrets-sensitive-data", "external-integration", "file-command-execution", "ci-deploy-permissions", "tenant-isolation"]
                }
              },
              "render_plan": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "R" } } },
      "then": {
        "properties": {
          "phase_data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["red_evidence", "green_evidence", "implementation_notes", "patch_path"],
            "properties": {
              "red_evidence": { "$ref": "#/$defs/testEvidence" },
              "green_evidence": { "$ref": "#/$defs/testEvidence" },
              "implementation_notes": { "type": "array", "items": { "type": "string" } },
              "patch_path": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "A" } } },
      "then": {
        "properties": {
          "phase_data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criteria_fit", "maintainability", "blocking_findings", "non_blocking_observations"],
            "properties": {
              "criteria_fit": {
                "type": "object",
                "additionalProperties": false,
                "required": ["passed", "rationale"],
                "properties": { "passed": { "type": "boolean" }, "rationale": { "type": "string" } }
              },
              "maintainability": {
                "type": "object",
                "additionalProperties": false,
                "required": ["correctness_risk", "locality_simplicity", "interface_clarity", "type_error_safety", "test_quality"],
                "properties": {
                  "correctness_risk": { "$ref": "#/$defs/score" },
                  "locality_simplicity": { "$ref": "#/$defs/score" },
                  "interface_clarity": { "$ref": "#/$defs/score" },
                  "type_error_safety": { "$ref": "#/$defs/score" },
                  "test_quality": { "$ref": "#/$defs/score" }
                }
              },
              "blocking_findings": { "$ref": "#/$defs/findings" },
              "non_blocking_observations": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "F" } } },
      "then": {
        "properties": {
          "phase_data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["findings_addressed", "documented_disagreements", "green_evidence", "patch_path"],
            "properties": {
              "findings_addressed": { "type": "array", "items": { "type": "string" } },
              "documented_disagreements": { "type": "array", "items": { "type": "string" } },
              "green_evidence": { "$ref": "#/$defs/testEvidence" },
              "patch_path": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "T" } } },
      "then": {
        "properties": {
          "phase_data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trust_boundaries_reviewed", "security_findings", "security_commands", "residual_risk"],
            "properties": {
              "trust_boundaries_reviewed": { "type": "array", "items": { "type": "string" } },
              "security_findings": { "$ref": "#/$defs/findings" },
              "security_commands": { "type": "array", "items": { "type": "string" } },
              "residual_risk": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "S" } } },
      "then": {
        "properties": {
          "phase_data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["docs_changed", "domain_instructions_changed", "wiki_pages_changed", "durable_learnings"],
            "properties": {
              "docs_changed": { "type": "array", "items": { "type": "string" } },
              "domain_instructions_changed": { "type": "array", "items": { "type": "string" } },
              "wiki_pages_changed": { "type": "array", "items": { "type": "string" } },
              "durable_learnings": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 4 },
        "rationale": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message", "evidence"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "message": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "suite_path", "suite_hash", "command", "exit_code", "image_digest", "output_artifact"],
      "properties": {
        "commit_sha": { "type": "string", "minLength": 1 },
        "suite_path": { "type": "string", "minLength": 1 },
        "suite_hash": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "image_digest": { "type": "string", "minLength": 1 },
        "output_artifact": { "type": "string", "minLength": 1 }
      }
    }
  }
}
