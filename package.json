{
  "name": "agent-pool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/agent-execution/*.test.ts test/codebase-knowledge/*.test.ts test/model-routing-and-evaluation/*.test.ts test/orchestration/*.test.ts test/verification/*.test.ts test/work-intake/*.test.ts",
    "test:pool-proof": "cd packages/pool-proof-harness && npm test",
    "test:worker": "cd packages/worker-harness && npm test",
    "proof:stage2:preflight": "cd packages/pool-proof-harness && npm run proof:stage2:preflight",
    "proof:stage2": "cd packages/pool-proof-harness && npm run proof:stage2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
