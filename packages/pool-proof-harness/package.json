{
  "name": "agent-pool-pool-proof-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/fixture-red-state.test.ts test/identity-resolution.test.ts test/persistent-attempt-sandbox-lifecycle-report.test.ts test/preflight-auth.test.ts test/report.test.ts test/retained-reports.test.ts test/run-stage-2.test.ts test/stage-1-harness.test.ts test/stage-2-report.test.ts",
    "proof:stage1:preflight": "node --experimental-strip-types src/preflight.ts",
    "proof:stage1": "node --experimental-strip-types src/run-stage-1.ts",
    "proof:stage1:publish": "node --experimental-strip-types src/run-stage-1.ts --publish",
    "proof:stage2:preflight": "node --experimental-strip-types src/preflight.ts",
    "proof:stage2": "node --experimental-strip-types src/run-stage-2.ts",
    "proof:stage2:publish": "node --experimental-strip-types src/run-stage-2.ts --publish",
    "proof:reports:verify": "node --experimental-strip-types src/verify-retained-reports.ts",
    "proof:reports:publish": "node --experimental-strip-types src/publish-retained-report.ts",
    "proof:sandbox-lifecycle:run": "node --experimental-strip-types --test test/persistent-attempt-sandbox-lifecycle.test.ts",
    "proof:sandbox-lifecycle": "npm run proof:sandbox-lifecycle:run"
  },
  "dependencies": {
    "agent-pool": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
