{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-manifest.schema.json",
  "title": "Reviewed Task Manifest",
  "description": "Untrusted-at-the-boundary reviewed manifest for one approved Agent Pool repository task. The strict validator in src/task-manifest.ts is authoritative at runtime; this contract mirrors its bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "target_repo_path",
    "base_commit",
    "intent",
    "change_spec",
    "acceptance_criteria",
    "allowed_changed_paths",
    "verification_commands",
    "model",
    "bounds"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "target_repo_path": { "type": "string", "minLength": 2, "pattern": "^/" },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "intent": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "change_spec": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "text": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "allowed_changed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(/|$))(?!.*(?:^|/)\\.git(/|$))[^/].*$"
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\n\\r]*$"
        }
      }
    },
    "model": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_timeout_seconds"],
      "properties": {
        "verification_timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 900 }
      }
    }
  }
}
