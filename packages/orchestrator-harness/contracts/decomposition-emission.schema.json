{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decomposition Emission",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intent", "change_spec", "acceptance_criteria", "depends_on"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "intent": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "change_spec": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
          },
          "depends_on": {
            "type": "array",
            "maxItems": 256,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  }
}
