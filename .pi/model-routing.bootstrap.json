{
  "version": 1,
  "status": "bootstrap-until-eval-derived",
  "comment": "Local-only bootstrap for building this repository in Pi. Remote craft-pool runtime uses its own routing, not this file.",
  "roles": {
    "node_conductor": {
      "primary": "openai-codex/gpt-5.6-terra",
      "fallback": []
    },
    "decomposition": {
      "primary": "openai-codex/gpt-5.6-sol",
      "fallback": []
    },
    "planning": {
      "primary": "openai-codex/gpt-5.6-sol",
      "fallback": []
    },
    "building": {
      "primary": "zai/glm-5.2",
      "fallback": []
    },
    "assessing": {
      "primary": "openai-codex/gpt-5.6-sol",
      "fallback": []
    },
    "tightening": {
      "primary": "openai-codex/gpt-5.6-terra",
      "fallback": []
    },
    "sharpening": {
      "primary": "openai-codex/gpt-5.6-terra",
      "fallback": []
    },
    "failure_diagnosis": {
      "primary": "openai-codex/gpt-5.6-terra",
      "fallback": []
    }
  },
  "rules": {
    "builderEvaluatorMustDiffer": true,
    "evaluatorMustNotBeLowerCapability": true,
    "reserveSolFromNormalBuilding": true,
    "failClosedOnUnavailableExplicitModel": true
  }
}
